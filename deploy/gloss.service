[Unit]
Description=gloss — word-root explorer (FastAPI/uvicorn)
After=network.target

[Service]
User=nthmost
Group=nthmost
WorkingDirectory=/opt/gloss/app
Environment=GLOSS_DB=/opt/gloss/data/gloss.sqlite
Environment=GLOSS_STATIC=/opt/gloss/app/static
# settings saved from /admin (model, passphrase, rate limit …) live here
Environment=GLOSS_SETTINGS=/opt/gloss/data/settings.json
# ANTHROPIC_API_KEY + GLOSS_ADMIN_PASSCODE; shipped by deploy.sh, optional
EnvironmentFile=-/opt/gloss/ask.env
ExecStart=/opt/gloss/app/.venv/bin/uvicorn gloss.app:app --host 127.0.0.1 --port 8902 --workers 2 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
